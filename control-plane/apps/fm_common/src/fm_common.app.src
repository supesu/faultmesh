{application, fm_common, [
    {description, "FaultMesh shared types, logger, telemetry, prometheus bridge"},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {fm_common_app, []}},
    {applications, [
        kernel,
        stdlib,
        public_key,
        jsx,
        telemetry,
        prometheus,
        prometheus_httpd,
        cowboy
    ]},
    {env, [
        {metrics_port, 9100}
    ]},
    {modules, []}
]}.
